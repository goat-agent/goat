  {
    "name": "drag",
    "title": "Drag",
    "description": "Presses at an element or point and releases at another: start from `ref` or `x`,`y`, end at `to_ref` or `to_x`,`to_y` (both in the same space as `shot`).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "An element ref from list_elements."
        },
        "x": {
          "type": [
            "number",
            "null"
          ],
          "description": "Horizontal position: screen points, or pixels of `shot` when it is given."
        },
        "y": {
          "type": [
            "number",
            "null"
          ],
          "description": "Vertical position: screen points, or pixels of `shot` when it is given."
        },
        "shot": {
          "type": [
            "string",
            "null"
          ],
          "description": "The screenshot `x` and `y` are measured in, from screenshot. Null means screen points."
        },
        "to_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "The element to drop on."
        },
        "to_x": {
          "type": [
            "number",
            "null"
          ],
          "description": "Where to release, horizontally."
        },
        "to_y": {
          "type": [
            "number",
            "null"
          ],
          "description": "Where to release, vertically."
        }
      },
      "required": [
        "ref",
        "x",
        "y",
        "shot",
        "to_ref",
        "to_x",
        "to_y"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Drag",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "scroll",
    "title": "Scroll",
    "description": "Scrolls at an element by `ref` or at a point by `x` and `y`, by `amount` wheel steps (default 3).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "An element ref from list_elements."
