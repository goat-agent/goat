[
  {
    "name": "list_windows",
    "title": "List windows",
    "description": "Lists the displays, the focused app and window, and every running app with its windows. Window ids go to list_elements, screenshot and set_window.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "title": "List windows",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "list_elements",
    "title": "List elements",
    "description": "Lists the accessible elements of a window: each has a `ref`, role, name, value, frame in screen points, and whether it is enabled or focused. Pass `find` to keep only elements whose name, value or role contains it, or `x` and `y` to get the element at that point. A ref lasts until list_elements is called again for the same window; a stale ref is refused, never guessed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "window": {
          "type": [
            "string",
            "null"
          ],
          "description": "A window id from list_windows. Null means the focused window."
        },
        "find": {
          "type": [
            "string",
            "null"
          ],
          "description": "Text the element's name, value or role must contain, ignoring case."
        },
        "x": {
          "type": [
            "number",
            "null"
          ],
          "description": "Horizontal position: screen points, or pixels of `shot` when it is given."
        },
        "y": {
          "type": [
            "number",
            "null"
          ],
          "description": "Vertical position: screen points, or pixels of `shot` when it is given."
        },
        "shot": {
          "type": [
            "string",
            "null"
          ],
          "description": "The screenshot `x` and `y` are measured in, from screenshot. Null means screen points."
        }
      },
      "required": [
        "window",
        "find",
        "x",
        "y",
        "shot"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "List elements",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "screenshot",
    "title": "Take a screenshot",
    "description": "Captures the main display, a window, or a region of either, and returns the image with its `shot` id, width and height. The terminal goat runs in is left out. Use the shot id with click, hover, drag, scroll and list_elements to give positions in the image's pixels.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "window": {
          "type": [
            "string",
            "null"
          ],
          "description": "A window id from list_windows. Null means the focused window."
        },
        "region": {
          "type": [
            "object",
            "null"
          ],
          "description": "Part to capture, in screen points; it is enlarged to show detail.",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "window",
        "region"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Take a screenshot",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "wait",
    "title": "Wait",
    "description": "Waits until an element whose name or value contains `text` appears in the window, or disappears when `gone` is true, or until `ref` is gone. Returns `found` false after `timeout_ms` (default 10000, at most 60000).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "window": {
          "type": [
            "string",
            "null"
          ],
          "description": "A window id from list_windows. Null means the focused window."
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Text to wait for."
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "An element ref to wait on; with gone true, waits until it disappears."
        },
        "gone": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Wait for the text or ref to disappear instead."
        },
        "timeout_ms": {
          "type": [
            "integer",
            "null"
          ],
          "description": "How long to wait, in milliseconds."
        }
      },
      "required": [
        "window",
        "text",
        "ref",
        "gone",
        "timeout_ms"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Wait",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "click",
    "title": "Click",
    "description": "Clicks an element by `ref`, or a point by `x` and `y`. A plain left or right click on a ref uses the element's own action and does not move the pointer; other clicks move the real pointer. Returns whether the window changed and which app received it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "An element ref from list_elements."
        },
        "x": {
          "type": [
            "number",
            "null"
          ],
          "description": "Horizontal position: screen points, or pixels of `shot` when it is given."
        },
        "y": {
          "type": [
            "number",
            "null"
          ],
          "description": "Vertical position: screen points, or pixels of `shot` when it is given."
        },
        "shot": {
          "type": [
            "string",
            "null"
          ],
          "description": "The screenshot `x` and `y` are measured in, from screenshot. Null means screen points."
        },
        "button": {
          "type": [
            "string",
            "null"
          ],
          "description": "Mouse button, default left.",
          "enum": [
            "left",
            "right",
            "middle",
            null
          ]
        },
        "count": {
          "type": [
            "integer",
            "null"
          ],
          "description": "1, 2 or 3 clicks, default 1.",
          "minimum": 1,
          "maximum": 3
        },
        "keys": {
          "type": [
            "string",
            "null"
          ],
          "description": "Modifiers held during the click, such as \"cmd\" or \"cmd+shift\"."
        }
      },
      "required": [
        "ref",
        "x",
        "y",
        "shot",
        "button",
        "count",
        "keys"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Click",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
