  {
    "name": "set_window",
    "title": "Set window",
    "description": "Focuses, minimizes, maximizes, restores or closes a window, and moves or resizes it with `x`, `y`, `width` and `height` in screen points. Closing asks the user first.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "window": {
          "type": "string",
          "description": "A window id from list_windows."
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "description": "The state to put the window in.",
          "enum": [
            "focused",
            "minimized",
            "maximized",
            "normal",
            "closed",
            null
          ]
        },
        "x": {
          "type": [
            "number",
            "null"
          ],
          "description": "New left edge."
        },
        "y": {
          "type": [
            "number",
            "null"
          ],
          "description": "New top edge."
        },
        "width": {
          "type": [
            "number",
            "null"
          ],
          "description": "New width."
        },
        "height": {
          "type": [
            "number",
            "null"
          ],
          "description": "New height."
        }
      },
      "required": [
        "window",
        "state",
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Set window",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
