{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "goat",
  "identifier": "dev.goat.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {"script":"bun run dev","cwd":"ui"},
    "beforeBuildCommand": {"script":"bun run build","cwd":"ui"}
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{"label":"main","title":"goat","width":1280,"height":820,"minWidth":900,"minHeight":600,"titleBarStyle":"Overlay","hiddenTitle":true,"dragDropEnabled":false}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {"minimumSystemVersion":"14.0","signingIdentity":"goat-desktop","entitlements":null,"infoPlist":"Info.plist"}
  }
}
