{
  "sourceLanguage": "en",
  "strings": {
    "6-digit code": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "6자리 코드"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용됨"
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용…"
          }
        }
      }
    },
    "Check the email address.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 주소를 확인해 주세요."
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결됨"
          }
        }
      }
    },
    "Connecting…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 중…"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속"
          }
        }
      }
    },
    "Couldn’t reach Goat. Try again in a moment.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Goat에 연결하지 못했어요. 잠시 후 다시 시도해 주세요."
          }
        }
      }
    },
    "Don’t Allow": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용 안 함"
          }
        }
      }
    },
    "Email": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일"
          }
        }
      }
    },
    "Enter the code": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드 입력"
          }
        }
      }
    },
    "Goat": {
      "shouldTranslate": false
    },
    "Goat needs two permissions to see and use your apps.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Goat가 앱을 보고 쓰려면 권한 두 개가 필요해요."
          }
        }
      }
    },
    "Let Goat bring %@ to the front?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Goat가 %@ 앱을 앞으로 가져와도 될까요?"
          }
        }
      }
    },
    "Let the agent use this Mac": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 이 맥 쓰기"
          }
        }
      }
    },
    "Offline": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인"
          }
        }
      }
    },
    "Quit Goat": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Goat 종료"
          }
        }
      }
    },
    "Screen & System Audio Recording": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 및 시스템 오디오 녹음"
          }
        }
      }
    },
    "Sign In": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인"
          }
        }
      }
    },
    "Sign Out": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃"
          }
        }
      }
    },
    "Sign in to Goat": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Goat에 로그인"
          }
        }
      }
    },
    "That code is not right. Check it and try again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 맞지 않아요. 확인하고 다시 입력해 주세요."
          }
        }
      }
    },
    "The agent needs %@ in front for a moment. Your pointer and the app you were using come back right after.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 잠깐 %@ 앱을 앞에 두고 써야 해요. 끝나면 포인터와 쓰던 앱이 바로 돌아와요."
          }
        }
      }
    },
    "Use a Different Email": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 이메일 쓰기"
          }
        }
      }
    },
    "Use the email of your Goat account.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Goat 계정의 이메일을 써 주세요."
          }
        }
      }
    },
    "We sent a 6-digit code to %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 6자리 코드를 보냈어요."
          }
        }
      }
    },
    "Working on this Mac…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 맥에서 작업 중…"
          }
        }
      }
    }
  },
  "version": "1.0"
}
