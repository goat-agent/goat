{
  "openapi": "3.1.0",
  "info": {
    "title": "Goat native bridge",
    "version": "1"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Empty": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "HostDevice": {
        "type": "object",
        "properties": {
          "installationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "installationId",
          "name"
        ],
        "additionalProperties": false
      },
      "Host": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "macos"
            ]
          },
          "device": {
            "$ref": "#/components/schemas/HostDevice"
          }
        },
        "required": [
          "platform",
          "device"
        ],
        "additionalProperties": false
      },
      "Permission": {
        "type": "string",
        "enum": [
          "accessibility",
          "screenRecording"
        ]
      },
      "ComputerUsePermissions": {
        "type": "object",
        "properties": {
          "accessibility": {
            "type": "boolean"
          },
          "screenRecording": {
            "type": "boolean"
          }
        },
        "required": [
          "accessibility",
          "screenRecording"
        ],
        "additionalProperties": false
      },
      "ComputerUse": {
        "type": "object",
        "properties": {
          "isEnabled": {
            "type": "boolean"
          },
          "permissions": {
            "$ref": "#/components/schemas/ComputerUsePermissions"
          }
        },
        "required": [
          "isEnabled",
          "permissions"
        ],
        "additionalProperties": false
      },
      "RequestMethod": {
        "type": "string",
        "enum": [
          "moveWindow",
          "doubleClickTitleBar",
          "authenticate",
          "computerUse",
          "setComputerUse",
          "openPermissionSettings"
        ]
      },
      "AuthenticateParams": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "AuthenticateResult": {
        "type": "object",
        "properties": {
          "callbackUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      },
      "SetComputerUseParams": {
        "type": "object",
        "properties": {
          "isEnabled": {
            "type": "boolean"
          }
        },
        "required": [
          "isEnabled"
        ],
        "additionalProperties": false
      },
      "OpenPermissionSettingsParams": {
        "type": "object",
        "properties": {
          "permission": {
            "$ref": "#/components/schemas/Permission"
          }
        },
        "required": [
          "permission"
        ],
        "additionalProperties": false
      },
      "EventName": {
        "type": "string",
        "enum": [
          "openSettings"
        ]
      }
    }
  }
}
