{
  "name": "@goat/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "bun run generate && vite build",
    "preview": "vite preview",
    "generate": "tsr generate && paraglide-js compile --project ./project.inlang --outdir ./src/shared/i18n/paraglide --strategy preferredLanguage baseLocale && openapi-typescript ../shared/GoatAPI/Sources/GoatAPI/openapi.json -o ./src/shared/api/schema.gen.ts",
    "typecheck": "bun run generate && tsc --noEmit",
    "test": "bun run generate && vitest run"
  },
  "dependencies": {
    "@shadcn/react": "0.3.1",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "input-otp": "^1.5.0",
    "lucide-react": "1.66.0",
    "openapi-fetch": "0.17.0",
    "pretendard": "1.3.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.29.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "msw": "3.0.3",
    "openapi-msw": "2.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
