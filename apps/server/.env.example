PORT=3000
DATABASE_URL=postgres://goat:goat@localhost:5432/goat
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:5173
BETTER_AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Goat <onboarding@resend.dev>
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
# provider:model for replies and for summaries; Claude when unset.
# AGENT_MODEL=openai:gpt-6.1-terra
# SUMMARY_MODEL=openai:gpt-6.1-terra
# File storage: any S3-compatible service. These match the local RustFS in compose.yaml.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=goat
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
LOG_LEVEL=info
# Where the embedding model is cached after its first download (about 300 MB).
# MODEL_CACHE_DIR=.cache/models
# openssl rand -base64 32
CREDENTIALS_KEY=
# Each integration is offered once its client id is set.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# NOTION_CLIENT_ID=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TODOIST_CLIENT_ID=
# GRANOLA_CLIENT_ID=
# READWISE_CLIENT_ID=
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# CANVA_CLIENT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Push notifications: an APNs auth key (.p8 contents, newlines as \n) from the Apple Developer account.
# APNS_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_ENVIRONMENT=development
