{
  "name": "@goat/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "auth generate --config src/lib/auth.ts --output src/db/schema/auth.ts --yes",
    "openapi": "bun run scripts/export-openapi.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.90",
    "@ai-sdk/openai": "4.0.104",
    "@hono/zod-openapi": "1.6.3",
    "ai": "7.0.155",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "postgres": "3.4.9",
    "resend": "6.35.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "auth": "1.7.14",
    "drizzle-kit": "0.31.11"
  }
}
