{
  "name": "@goat/sdk",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./provider": "./src/provider/index.ts",
    "./provider/testing": "./src/provider/testing/index.ts",
    "./provider-anthropic": "./src/provider-anthropic/index.ts",
    "./provider-openai": "./src/provider-openai/index.ts",
    "./sse": "./src/sse/index.ts"
  },
  "scripts": {
    "check": "bun run format:check && bun run lint && turbo run typecheck test && bun run knip",
    "fix": "oxfmt && oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "knip": "knip",
    "record:anthropic": "bun scripts/record-anthropic.ts",
    "record:openai": "bun scripts/record-openai.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "knip": "6.39.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
