{
  "name": "goat",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@goat/server --filter=@goat/web",
    "dev:ios": "turbo run dev --filter=@goat/ios",
    "dev:macos": "turbo run dev --filter=@goat/macos",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
